# offline | claude | openai | ollama
CONTRACTLENS_PROVIDER=offline

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=   # any OpenAI-compatible endpoint (Groq, Together, vLLM, Azure...)

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Optional
# CONTRACTLENS_PLAYBOOK=/app/playbooks/my_playbook.yaml
# CONTRACTLENS_EMBEDDINGS=1
CONTRACTLENS_MAX_MB=10
